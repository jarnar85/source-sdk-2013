@include "base.fgd"
@include "halflife2.fgd"

@BaseClass base(Targetname, Parentname, Angles) = vgui_screen
[
	panelname(string) : "Panel Name"
	overlaymaterial(string) : "Overlay Material" : "" : "Name of a material to overlay over the top of the VGUI screen. NOTE: This material must write Z for the VGUI screen to work."
	width(integer) : "Panel Width in World" : 32 : "Width of the panel in units."
	height(integer) : "Panel Height in World" : 32 : "Height of the panel in units."

	// Inputs
	input SetActive(void) : "Make the vgui screen visible."
	input SetInactive(void) : "Make the vgui screen invisible."
	output Output1(void) : "Fire output 1."
	output Output2(void) : "Fire output 2."
	output Output3(void) : "Fire output 3."
	output Output4(void) : "Fire output 4."
	output Output5(void) : "Fire output 5."
	output Output6(void) : "Fire output 6."
	output Output7(void) : "Fire output 7."
	output Output8(void) : "Fire output 8."
	output Output9(void) : "Fire output 9."
	output Output10(void) : "Fire output 10."
	output Output11(void) : "Fire output 11."
	output Output12(void) : "Fire output 12."
	output Output13(void) : "Fire output 13."
	output Output14(void) : "Fire output 14."
	output Output15(void) : "Fire output 15."
	output Output16(void) : "Fire output 16."
]


//-------------------------------------------------------------------------
//
// Functionalities
//
//-------------------------------------------------------------------------

@PointClass base(Targetname) = game_player_class : "Change Player Class"
[
	spawnflags(flags) =
	[
		2 : "Run only once" : 1
		4 : "Execute when map is loaded" : 0
	]
	
	target(choices) : "Target Class":"player" =
	[
		"player":"Player"
		"citizen":"Citizen"
		"rebel":"Rebel"
		"rebel_medic":"Rebel (medic)"
		"manhack":"Manhack"
		"metropolice":"Metrocop"
		"combine_prisonguard":"Combine prison guard"
		"combine_prisonheavy":"Combine prison guard (shotgunner)"
		"combine_soldier":"Combine soldier"
		"combine_charger":"Combine soldier (charger)"
		"combine_elite":"Combine soldier (elite)"
		"combine_grunt":"Combine soldier (grunt)"
		"combine_heavy":"Combine soldier (heavy)"
		"combine_medic":"Combine soldier (medic)"
		"combine_ordinal":"Combine soldier (ordinal)"
		"combine_suppressor":"Combine soldier (suppressor)"
		"combine_worker":"Combine worker"
		"combine_worker_hazmat":"Combine worker (Hazmat)"
		"conscript":"Conscript"
		"soldier":"Human Soldier"
		"stalker":"Stalker"
		"zombie":"Zombie"
		"zombie_poison":"Zombie (poison)"
		"zombie_fast":"Zombie (fast)"
		"zombie_combine":"Zombie (combine)"
	]
	
	input Enable(void) : "Set the player class."
]


//-------------------------------------------------------------------------
//
// Filters
//
//-------------------------------------------------------------------------

@FilterClass base(BaseFilter) iconsprite("editor/filter_class_t.vmt") = filter_activator_class_t :
	"A filter that filters by the class of the activator."
[
	filterclass_t(string) : "Filter Class" : : "The class to filter by. If the filter mode is Allow, only entities whose "+
		"class matches the given string will pass the filter. If the filter mode is Disallow, "+
		"all entities EXCEPT those whose class matches the given string will pass the filter."
]


//-------------------------------------------------------------------------
//
// NPCs
//
//-------------------------------------------------------------------------

@NPCClass base(BaseNPC) studio("models/bullsquid.mdl" ) = npc_bullsquid : "Bullsquid"[]


//-------------------------------------------------------------------------
//
// Flaregun
//
//-------------------------------------------------------------------------

@PointClass base(Item) studio("models/items/boxflares.mdl")= item_box_flare_rounds : "Box of Flare Rounds" []
@PointClass base(Weapon) studio("models/weapons/w_pistol.mdl") = weapon_flaregun : "Flaregun" []

