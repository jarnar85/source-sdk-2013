@include "base.fgd"
@include "halflife2.fgd"

@BaseClass base(Targetname, Parentname, Angles) = vgui_screen
[
	panelname(string) : "Panel Name"
	overlaymaterial(string) : "Overlay Material" : "" : "Name of a material to overlay over the top of the VGUI screen. NOTE: This material must write Z for the VGUI screen to work."
	width(integer) : "Panel Width in World" : 32 : "Width of the panel in units."
	height(integer) : "Panel Height in World" : 32 : "Height of the panel in units."

	// Inputs
	input SetActive(void) : "Make the vgui screen visible."
	input SetInactive(void) : "Make the vgui screen invisible."
	output AnyOutput(void) : "Fire any output."
	output Output1(void) : "Fire output 1."
	output Output2(void) : "Fire output 2."
	output Output3(void) : "Fire output 3."
	output Output4(void) : "Fire output 4."
	output Output5(void) : "Fire output 5."
	output Output6(void) : "Fire output 6."
	output Output7(void) : "Fire output 7."
	output Output8(void) : "Fire output 8."
	output Output9(void) : "Fire output 9."
	output Output10(void) : "Fire output 10."
	output Output11(void) : "Fire output 11."
	output Output12(void) : "Fire output 12."
	output Output13(void) : "Fire output 13."
	output Output14(void) : "Fire output 14."
	output Output15(void) : "Fire output 15."
	output Output16(void) : "Fire output 16."
]

//-------------------------------------------------------------------------
//
// Logic Entities
//
//-------------------------------------------------------------------------

@PointClass base(Targetname) iconsprite("editor/logic_compare.vmt") = logic_compare :
	"Compares an input value to another value. " +
	"If the input value is less than the compare value, the OnLessThan and OnLessEqual outputs are fired with the input value. " +
	"If the input value is equal to the compare value, the OnLessEqual, OnEqualTo and OnGreaterEqual outputs are fired with the input value. " +	
	"If the input value is greater than the compare value, the OnGreaterThan and OnGreaterEqual outputs are fired with the input value."
[
	// Keys
	InitialValue(integer) : "Initial value" : : "Initial value for the input value."
	CompareValue(integer) : "Compare value" : : "The value to compare against."
	
	// Inputs
	input SetValue(float) : "Set the value that will be compared against the compare value."
	input SetValueCompare(float) : "Set the value that will be compared against the compare value and performs the comparison."
	input SetCompareValue(float) : "Set the compare value."
	input Compare(void) : "Force a compare of the input value with the compare value."
	
	// Outputs
	output OnLessThan(float) : "Fired when the input value is less than the compare value. Sends the input value as data." 
	output OnLessEqual(float) : "Fired when the input value is less than or equal to the compare value. Sends the input value as data." 
	output OnEqualTo(float) : "Fired when the input value is equal to the compare value. Sends the input value as data." 
	output OnNotEqualTo(float) : "Fired when the input value is different from the compare value. Sends the input value as data." 
	output OnGreaterEqual(float) : "Fired when the input value is equal to or greater than the compare value. Sends the input value as data."
	output OnGreaterThan(float) : "Fired when the input value is greater than the compare value. Sends the input value as data."
]

@PointClass base(Targetname) iconsprite("editor/logic_branch.vmt") = logic_playerclass : "Compare Player Class to a set value"
[
	spawnflags(flags) =
	[
		2 : "Run only once" : 0
	]
	
	target(choices) : "Target Class":"player" =
	[
		"player":"Player"
		"citizen":"Citizen"
		"rebel":"Rebel"
		"rebel_medic":"Rebel (medic)"
		"manhack":"Manhack"
		"metropolice":"Metrocop"
		"metropolice_recruit":"Metrocop recruit"
		"combine_prisonguard":"Combine prison guard"
		"combine_prisonheavy":"Combine prison guard (shotgunner)"
		"combine_soldier":"Combine soldier"
		"combine_charger":"Combine soldier (charger)"
		"combine_elite":"Combine soldier (elite)"
		"combine_grunt":"Combine soldier (grunt)"
		"combine_heavy":"Combine soldier (heavy)"
		"combine_medic":"Combine soldier (medic)"
		"combine_ordinal":"Combine soldier (ordinal)"
		"combine_suppressor":"Combine soldier (suppressor)"
		"combine_worker":"Combine worker"
		"combine_worker_hazmat":"Combine worker (Hazmat)"
		"conscript":"Conscript"
		"soldier":"Human Soldier"
		"stalker":"Stalker"
		"zombie":"Zombie"
		"zombie_poison":"Zombie (poison)"
		"zombie_fast":"Zombie (fast)"
		"zombie_combine":"Zombie (combine)"
	]
	
	// Inputs
	input Compare(void) : "Compare the player class with the target class."
	
	// Outputs
	output OnTrue(bool) : "Fired when player class matches." 
	output OnFalse(bool) : "Fired when player class does not match." 
]

